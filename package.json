{
  "name": "burrow",
  "version": "1.1.0",
  "description": "Burrow – Mo der Maulwurf gräbt deinen lokalen Dev-Server per ngrok-Tunnel aufs Handy (Electron-Desktop-App)",
  "type": "module",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "server": "node src/server.js",
    "icons": "node scripts/build-icons.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "check": "npm run lint && npm run format:check && npm test",
    "build": "electron-builder --win --x64 --publish never",
    "build:dir": "electron-builder --win --x64 --dir --publish never"
  },
  "build": {
    "appId": "dev.burrow.app",
    "productName": "Burrow",
    "copyright": "Copyright © 2026 FlyingV111",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Burrow-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Burrow",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Burrow-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Burrow-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.4.1",
    "express": "^5.3.0",
    "http-proxy": "^1.18.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "FlyingV111",
  "license": "MIT",
  "keywords": [
    "ngrok",
    "tunnel",
    "electron",
    "localhost",
    "qr-code",
    "dev-tools"
  ],
  "overrides": {
    "qs": "^6.17.1"
  },
  "homepage": "https://github.com/FlyingV111/burrow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlyingV111/burrow.git"
  },
  "bugs": {
    "url": "https://github.com/FlyingV111/burrow/issues"
  }
}
